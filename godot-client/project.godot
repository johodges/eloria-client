; Engine configuration file.
; Eloria Godot client — pinned to Godot 4.7.2-stable.
config_version=5

[application]
config/name="Eloria"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
AppState="*res://src/state/app_state.gd"
Network="*res://src/network/network_client.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 4x anisotropic. World textures are rebuilt with mip chains at load, and a
; mip chain alone blurs ground seen at the grazing angle an isometric camera
; spends most of its time at.
textures/default_filters/anisotropic_filtering_level=2

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.en.translation")

[input]

toggle_sit={
"deadzone": 0.5,
"events": [Object(InputEventKey,"alt_pressed":true,"physical_keycode":83,"unicode":115)]
}
connect={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":67,"ctrl_pressed":true)] }
disconnect={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68,"ctrl_pressed":true)] }
chat_focus={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":84)] }
; Godot 4 KEY_TAB is 4194306. The ASCII 9 this used to hold is a Godot 3
; value that matches no key, so Tab fell through to ui_focus_next and walked
; the focus ring around the HUD buttons instead of opening the map.
toggle_map={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194306)] }
toggle_minimap={ "deadzone": 0.5, "events": [Object(InputEventKey,"alt_pressed":true,"physical_keycode":77)] }
toggle_show_through_obstacles={ "deadzone": 0.5, "events": [Object(InputEventKey,"alt_pressed":true,"physical_keycode":86)] }
toggle_console={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":96)] }
toggle_inventory={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":73,"ctrl_pressed":true)] }
; Ctrl+E. Turning right is a bare E, so this is resolved with an exact
; modifier match and ahead of turn_right, which is otherwise happy to take a
; key event that carries a Ctrl it was never bound with.
toggle_encyclopedia={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69,"ctrl_pressed":true)] }
; The Eternal Lands window keys, one per window the legacy client binds.
; Resolved in _unhandled_input after the window loop decided their order,
; so a focused text field keeps its own Ctrl shortcuts.
toggle_spells={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":83,"ctrl_pressed":true)] }
toggle_manufacture={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":77,"ctrl_pressed":true)] }
toggle_emotes={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":74,"ctrl_pressed":true)] }
toggle_quest_journal={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":71,"ctrl_pressed":true)] }
toggle_buddy={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":66,"ctrl_pressed":true)] }
toggle_stats={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65,"ctrl_pressed":true)] }
toggle_ranging={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":84,"ctrl_pressed":true)] }
toggle_help={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":72,"ctrl_pressed":true)] }
toggle_notepad={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":78,"ctrl_pressed":true)] }
toggle_options={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":79,"ctrl_pressed":true)] }
toggle_mail={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":76,"ctrl_pressed":true)] }
toggle_party={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":80,"ctrl_pressed":true)] }
recenter_viewport={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)] }
move_north={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":87)] }
move_south={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":83)] }
move_west={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65)] }
move_east={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68)] }
turn_left={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":81)] }
turn_right={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69)] }
screenshot={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194338)] }
cancel={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305)] }
attack_selected={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65,"alt_pressed":true)] }
quick_item_1={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":49)] }
quick_item_2={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":50)] }
quick_item_3={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":51)] }
quick_item_4={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":52)] }
quick_item_5={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":53)] }
quick_item_6={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":54)] }
quick_item_7={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":55)] }
quick_item_8={ "deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":56)] }
quick_spell_1={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":49)] }
quick_spell_2={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":50)] }
quick_spell_3={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":51)] }
quick_spell_4={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":52)] }
quick_spell_5={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":53)] }
quick_spell_6={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":54)] }
quick_spell_7={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":55)] }
quick_spell_8={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":56)] }
quick_spell_9={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":57)] }
quick_spell_10={ "deadzone": 0.5, "events": [Object(InputEventKey,"shift_pressed":true,"physical_keycode":48)] }
quick_spell_11={ "deadzone": 0.5, "events": [] }
