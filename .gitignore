*.o
__pycache__/
*.py[cod]
godot-client/.godot/
godot-client/test-artifacts/
godot-client/**/*.import
godot-client/**/*.uid
godot-client/assets/actors/native/races/* *.png
godot-client/assets/actors/native/hair/* *.png
# Godot's glTF importer writes every embedded texture back out beside the GLB.
# They are build output, not source, and the GLB already carries them.
godot-client/assets/actors/native/equipment/*.png
godot-client/assets/actors/native/creatures/*.png
.deps/
make.conf
el.linux.bin
git_version
map_editor/mapedit.x86.linux.bin
docs/DOXYTAGS
docs/html
pawn_scripts/*.amx
pawn_scripts/features.inc

# macOS Specific
.DS_Store
.DS_Store?
xcuserdata/

# CLion workspace files
.idea/
cmake-build-*/

# The Godot editor/runtime binary, kept beside the project for local runs. It
# is 180 MB and must never enter a commit.
godot-client/Godot_v*.exe
godot-client/Godot_v*

# Godot editor artefacts. The godot-client project is imported by CI
# ("godot --headless --path godot-client --editor --quit"), which regenerates
# all of these, so none of them belong in the tree.
godot-client/.godot/
*.import
*.uid
godot-client/assets/actors/native/creatures/*-basecolor.png
godot-client/assets/actors/native/races/*Atlas.png
godot-client/**/*.glb.report.json

# Rendered test evidence. CI uploads it as a build artifact.
godot-client/test-artifacts/

# Validator reports written beside the map packages they describe.
eloria-assets/maps/*/world.glb.report.json
